{
  "name": "woody",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.rmSync('.next',{recursive:true,force:true});try{fs.rmSync('node_modules/.cache',{recursive:true,force:true})}catch(e){}\"",
    "dev": "next dev -p 8888",
    "dev:fresh": "npm run clean && next dev -p 8888",
    "dev:3000": "next dev -p 3000",
    "dev:spotify": "next dev -p 8888 -H 127.0.0.1",
    "dev:fresh:spotify": "npm run clean && next dev -p 8888 -H 127.0.0.1",
    "build": "next build",
    "build:clean": "npm run clean && npm run build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@anthropic-ai/sdk": "^0.37.0",
    "spotify-web-api-node": "^5.0.2",
    "zustand": "^5.0.0",
    "framer-motion": "^11.0.0",
    "three": "^0.170.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/drei": "^10.0.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.170.0",
    "@types/spotify-web-api-node": "^5.0.11",
    "tailwindcss": "^3.4.0",
    "postcss": "^8",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "15.1.0",
    "vitest": "^3.0.0"
  }
}
