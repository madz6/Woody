# Spotify API
# Create an app at https://developer.spotify.com/dashboard and register the
# exact callback URL used by the app.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/api/auth/callback

# Optional app origin override for production/tunnel deployments.
# AUTH_APP_URL=https://your-private-app.example

# AI suggestions are optional. Journey planning has a deterministic fallback.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_rotated_gemini_api_key
ANTHROPIC_API_KEY=

# Acoustic journey service.
ACOUSTIC_SERVICE_URL=http://127.0.0.1:8765
ACOUSTIC_SERVICE_TOKEN=replace_with_a_long_random_shared_secret

# Optional local diagnostics. Keep disabled in production.
SPOTIFY_DIAGNOSE=false

# Legacy placeholder; currently unused.
NEXTAUTH_SECRET=
